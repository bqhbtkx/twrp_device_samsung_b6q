# mount point  fstype  device                                      [device2]                  flags
/boot          emmc    /dev/block/bootdevice/by-name/boot                                         flags=display="Boot";backup=1;flashimg=1
/init_boot     emmc    /dev/block/bootdevice/by-name/init_boot                                    flags=display="Init Boot";backup=1;flashimg=1
/vendor_boot   emmc    /dev/block/bootdevice/by-name/vendor_boot                                  flags=display="Vendor Boot";backup=1;flashimg=1
/recovery      emmc    /dev/block/bootdevice/by-name/recovery                                     flags=display="Recovery";backup=1;flashimg=1
/dtbo          emmc    /dev/block/bootdevice/by-name/dtbo                                         flags=display="DTBO";backup=1;flashimg=1
/vbmeta        emmc    /dev/block/bootdevice/by-name/vbmeta                                       flags=display="VBMeta";backup=1;flashimg=1
/vbmeta_system emmc    /dev/block/bootdevice/by-name/vbmeta_system                                flags=display="VBMeta System";backup=1;flashimg=1
/vbmeta_samsung emmc   /dev/block/bootdevice/by-name/vbmeta_samsung                               flags=display="VBMeta Samsung";backup=1;flashimg=1

/cache         ext4    /dev/block/bootdevice/by-name/cache                                        flags=display="Cache";wipeingui
/efs           ext4    /dev/block/bootdevice/by-name/sec_efs                                      flags=display="EFS";backup=1
/sec_efs       ext4    /dev/block/bootdevice/by-name/sec_efs                                      flags=display="Sec EFS";backup=1
/persist       ext4    /dev/block/bootdevice/by-name/persist                                      flags=display="Persist";backup=1
/prism         ext4    /dev/block/bootdevice/by-name/prism                                        flags=display="Prism";backup=1
/optics        ext4    /dev/block/bootdevice/by-name/optics                                       flags=display="Optics";backup=1
/modem         vfat    /dev/block/bootdevice/by-name/apnhlos                                      flags=display="Modem";mounttodecrypt
/firmware_modem vfat   /dev/block/bootdevice/by-name/modem                                        flags=display="Modem FW";mounttodecrypt
/dsp           ext4    /dev/block/bootdevice/by-name/dsp                                          flags=display="DSP";backup=1

/usb-otg       auto    /dev/block/sdg1                               /dev/block/sdg               flags=display="USB-OTG";storage;wipeingui;removable
