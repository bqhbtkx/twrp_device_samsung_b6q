# mount point       fstype  device                                      device2                  flags
# Logical partitions
/system_image       emmc    /dev/block/bootdevice/by-name/system                                   flags=backup=0;flashimg;display="System Image"
/vendor_image       emmc    /dev/block/bootdevice/by-name/vendor                                   flags=backup=0;flashimg;display="Vendor Image"
/product_image      emmc    /dev/block/bootdevice/by-name/product                                  flags=backup=0;flashimg;display="Product Image"
/odm_image          emmc    /dev/block/bootdevice/by-name/odm                                      flags=backup=0;flashimg;display="ODM Image"
/system_ext_image   emmc    /dev/block/bootdevice/by-name/system_ext                               flags=backup=0;flashimg;display="System_EXT Image"
/vendor_dlkm_image  emmc    /dev/block/bootdevice/by-name/vendor_dlkm                              flags=backup=0;flashimg;display="Vendor_DLKM Image"
/system_dlkm_image  emmc    /dev/block/bootdevice/by-name/system_dlkm                              flags=backup=0;flashimg;display="System_DLKM Image"

# Physical partitions
/boot               emmc    /dev/block/bootdevice/by-name/boot                                     flags=display="Boot";backup=1;flashimg=1
/init_boot          emmc    /dev/block/bootdevice/by-name/init_boot                                flags=display="Init Boot";backup=1;flashimg=1
/vendor_boot        emmc    /dev/block/bootdevice/by-name/vendor_boot                              flags=display="Vendor Boot";backup=1;flashimg=1
/recovery           emmc    /dev/block/bootdevice/by-name/recovery                                 flags=display="Recovery";backup=1;flashimg=1
/dtbo               emmc    /dev/block/bootdevice/by-name/dtbo                                     flags=display="DTBO";backup=1;flashimg=1
/vbmeta             emmc    /dev/block/bootdevice/by-name/vbmeta                                   flags=display="VBMeta";backup=1;flashimg=1
/vbmeta_system      emmc    /dev/block/bootdevice/by-name/vbmeta_system                            flags=display="VBMeta System";backup=1;flashimg=1
/vbmeta_samsung     emmc    /dev/block/bootdevice/by-name/vbmeta_samsung                           flags=display="VBMeta Samsung";backup=1;flashimg=1

/cache              ext4    /dev/block/bootdevice/by-name/cache                                    flags=display="Cache";wipeingui
/persist            ext4    /dev/block/bootdevice/by-name/persist                                  flags=display="Persist";backup=1
/efs                emmc    /dev/block/bootdevice/by-name/efs                                      flags=display="EFS";backup=1
/sec_efs            emmc    /dev/block/bootdevice/by-name/sec_efs                                  flags=display="Sec EFS";subpartitionof=/efs;backup=1
/prism              emmc    /dev/block/bootdevice/by-name/prism                                    flags=display="Prism";backup=1;flashimg=1
/optics             emmc    /dev/block/bootdevice/by-name/optics                                   flags=display="Optics";backup=1;flashimg=1
/firmware           emmc    /dev/block/bootdevice/by-name/apnhlos                                  flags=display="Firmware";backup=1
/modem              emmc    /dev/block/bootdevice/by-name/modem                                    flags=display="Modem";backup=1
/dsp                emmc    /dev/block/bootdevice/by-name/dsp                                      flags=display="DSP";backup=1

/usb-otg            auto    /dev/block/sdg1                               /dev/block/sdg           flags=display="USB-OTG";storage;wipeingui;removable
